node_modules/
dist/
coverage/
# Voice-coach dev tooling: keep the generation scripts, never commit the Python
# venv, the downloaded Kokoro model, or generated audition audio.
voice-dev/venv/
voice-dev/models/
voice-dev/audition/
# The served coach audio lives in docs/voices (committed). web/voices is the local
# generation source that the build mirrors to docs — regenerate it, don't commit it.
web/voices/
# The anatomical stretch frames are mirrored from assets/anatomical-stretch-motion/assets/frames
# into docs/stretch-frames (committed, Pages-served) and web/stretch-frames (local serving only).
web/stretch-frames/
*.tsbuildinfo
.DS_Store
# Verification marker (this project's own gate signal; not source)
.verify-ok

# ElevenLabs: the key is a secret and stays on this machine; the venv and auditions are artefacts.
voice-dev/elevenlabs-key.txt
voice-dev/venv-el/
voice-dev/audition-el-*.mp3

# Personal voice packs: clips in which a coach speaks a real person's name. These are generated for
# one runner, baked into their own build, and must never reach the public repo or GitHub Pages.
web/voices-personal/
docs/voices-personal/
voice-dev/personal.json

# ⚠️ The Mapbox token is billable and this repo is public. It is copied into the app bundle at build
# time by the "Embed web app" phase and must never be committed — a token in git history is a token
# that has been published, whatever is done afterwards.
ios/mapbox-token.txt

# Strava API credentials — the client secret must never be committed.
strava-secret.txt
alfie-proxy/.dev.vars
