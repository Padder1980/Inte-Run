<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Export settings for a TestFlight / App Store build. `app-store-connect` is the method for
       both: TestFlight is simply an App Store build that has not been released. -->
  <key>method</key>
  <string>app-store-connect</string>
  <!-- Let Xcode fetch and renew the distribution profiles rather than pinning one here: a pinned
       profile expires and the failure names the wrong problem. -->
  <key>signingStyle</key>
  <string>automatic</string>
  <!-- Symbols go up so crash reports from testers are readable. Without this a crash is an address. -->
  <key>uploadSymbols</key>
  <true/>
  <!-- ⚠️ OFF. Bitcode is long dead for iOS and leaving it on produces a confusing warning. -->
  <key>compileBitcode</key>
  <false/>
  <!-- Keep the watch app and the widget extension in the upload; they are the point of the app. -->
  <key>stripSwiftSymbols</key>
  <true/>
</dict>
</plist>
