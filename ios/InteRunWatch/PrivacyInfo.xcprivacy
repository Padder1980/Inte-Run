<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ⚠️ THE WATCH APP NEEDS ITS OWN FILE (added in Y6, 27 Sept 2026). Apple checks every binary in an
       upload for "required reason" APIs, and this one uses UserDefaults (WatchSettings, and the cached
       plan in SessionStore) -- so without this file the watch binary is the one that draws ITMS-91053,
       "Missing API Declaration", even though the phone app's own file is complete. -->

  <!-- Nothing leaves the watch for a server. A run goes to the paired iPhone over WatchConnectivity and
       to Health on the watch itself; whatever the iPhone app then sends is declared in ITS file
       (ios/InteRun/PrivacyInfo.xcprivacy) and in APPSTORE.md. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- CA92.1, in Apple's words: "to read and write information that is only accessible to the app
           itself". The runner's watch settings and the last plan the phone sent. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
